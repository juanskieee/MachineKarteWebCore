<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Reporting\**;TempData\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Legacy\**" />
    <Compile Remove="Uploads\**" />
    <Content Remove="Legacy\**" />
    <Content Remove="Uploads\**" />
    <EmbeddedResource Remove="Legacy\**" />
    <EmbeddedResource Remove="Uploads\**" />
    <None Remove="Legacy\**" />
    <None Remove="Uploads\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Reporting\LegacyReports.vbproj" />
    <None Update="Templates/**/*;Assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GemBox.Spreadsheet" Version="2026.10.101" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

</Project>
