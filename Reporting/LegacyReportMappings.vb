Public Sub PopulatePm(wb As ExcelFile, process As String, current As IDictionary(Of String, Object), history As IList(Of IDictionary(Of String, Object)))
Select Case process
Case "MEMS" : PmMEMS(wb, New LegacyRecord(current), history)
Case "WB" : PmWB(wb, New LegacyRecord(current), history)
Case "DB" : PmDB(wb, New LegacyRecord(current), history)
Case "DC" : PmDC(wb, New LegacyRecord(current), history)
Case "MP" : PmMP(wb, New LegacyRecord(current), history)
Case "PL" : PmPL(wb, New LegacyRecord(current), history)
Case "FT" : PmFT(wb, New LegacyRecord(current), history)
Case "SING" : PmSING(wb, New LegacyRecord(current), history)
Case "FL" : PmFL(wb, New LegacyRecord(current), history)
Case "TP" : PmTP(wb, New LegacyRecord(current), history)
Case "EDS" : PmEDS(wb, New LegacyRecord(current), history)
Case Else : Throw New ArgumentException("Unsupported PM report process.")
End Select
End Sub
Public Sub PopulateTe(wb As ExcelFile, process As String, current As IDictionary(Of String, Object))
If process = "EDS" Then
TE_EDS(wb, New LegacyRecord(current), process)
Else
TE(wb, New LegacyRecord(current), process)
End If
End Sub
