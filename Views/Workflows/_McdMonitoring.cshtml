<div class="workflow workflow--McdMonitoring" data-workflow="McdMonitoring">
    <div class="mcd-page">

        <div class="mcd-filter-bar card">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="McdMonitoring-dtFrom">Date From</label>
                    <input type="datetime-local" id="McdMonitoring-dtFrom" data-id="dtFrom" class="form-control" />
                </div>
                <div class="filter-group">
                    <label for="McdMonitoring-dtTo">Date To</label>
                    <input type="datetime-local" id="McdMonitoring-dtTo" data-id="dtTo" class="form-control" />
                </div>
                <div class="filter-group">
                    <label for="McdMonitoring-selUser">User Role</label>
                    <select id="McdMonitoring-selUser" data-id="selUser" class="form-control">
                        <option value="">Standard</option>
                        <option value="TE">TE</option>
                    </select>
                </div>
                <div class="filter-group filter-btn-group">
                    <button id="McdMonitoring-btnSearch" data-id="btnSearch" class="btn btn-primary" type="button">
                        Search
                    </button>
                </div>
                <div class="filter-group filter-status-group">
                    <span id="McdMonitoring-lblStatus" data-id="lblStatus" class="mcd-status"></span>
                </div>
            </div>
            <div id="McdMonitoring-progressBar" data-id="progressBar" class="mcd-progress is-hidden">
                <div class="mcd-progress-inner" id="McdMonitoring-progressInner" data-id="progressInner"></div>
            </div>
        </div>

        <div class="mcd-grid-wrapper card" id="McdMonitoring-dashboardWrapper" data-id="dashboardWrapper">
            <div class="mcd-grid" id="McdMonitoring-gridContainer" data-id="gridContainer">
                <div class="mcd-grid-empty">Select a date range and click Search.</div>
            </div>
        </div>

        <div id="McdMonitoring-machinePanel" data-id="machinePanel" class="mcd-machine-panel is-hidden">
            <div class="mcd-machine-panel-header">
                <span id="McdMonitoring-panelTitle" data-id="panelTitle">Machines</span>
                <button type="button" class="mcd-panel-close" id="McdMonitoring-btnPanelClose" data-id="btnPanelClose">&times;</button>
            </div>
            <ul id="McdMonitoring-machineList" data-id="machineList" class="mcd-machine-list"></ul>
            <div class="mcd-panel-footer">
                <button type="button" class="btn btn-secondary" id="McdMonitoring-btnPanelCancel" data-id="btnPanelCancel">Close</button>
                <button type="button" class="btn btn-primary" id="McdMonitoring-btnGoToMonitoring" data-id="btnGoToMonitoring">Go to Monitoring</button>
            </div>
        </div>
        <div id="McdMonitoring-panelOverlay" data-id="panelOverlay" class="mcd-overlay is-hidden"></div>

    </div>

    @Html.AntiForgeryToken()
</div>
