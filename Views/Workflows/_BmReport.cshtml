@model ReportWorkflowViewModel
<div class="workflow workflow--BmReport" data-workflow="BmReport">
    <div class="document-toolbar">
        <p>Process: <strong>@Model.Process</strong> | BM ID: <strong>@Model.BmId</strong></p>
        <form id="BmReport-frmDownload" data-id="frmDownload" method="post" action="@Url.Content("~/BmReport?handler=DownloadReport")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bmId" value="@Model.BmId" />
            <input type="hidden" name="process" value="@(string.IsNullOrEmpty(Model.Process) ? "TE" : Model.Process)" />
            <label>Format <select name="format" data-id="outputFormat"><option value="xlsx">Excel (.xlsx)</option><option value="pdf">PDF</option></select></label>
            <button type="submit" id="BmReport-btnDownload" data-id="btnDownload" class="btn-generate">Generate report</button>
        </form>
    </div>
    @await Html.PartialAsync("_ReportOutput", new ReportOutputViewModel("BmReport", "reportStatus", "reportDownload", "report", "TE maintenance report PDF preview"))
</div>
