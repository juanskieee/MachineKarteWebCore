@page
@model MachineKarte.Web.Pages.ActionCardsModel
@{
    ViewData["Title"] = "Check And Action Card";
    ViewData["Page"] = "ActionCards";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/ActionCard.css" />
}

<!-- ════════════════════════════════════════════════════
     MACHINE NO BANNER  (tbMachineNo — grey, large font)
     Displayed at the very top, read-only.
     ════════════════════════════════════════════════════ -->
<div id="machineNoBanner" class="mc-banner" style="display:none;">
    <span id="bannerMcNo"></span>
    <span id="bannerHeaderCase" class="banner-case"></span>
</div>

<!-- ════════════════════════════════════════════════════
     MAIN FORM PANEL  (Panel1 — dark #343434 background)
     AutoScroll equivalent = overflow-y: auto on .ac-panel
     ════════════════════════════════════════════════════ -->
<div class="ac-panel" id="acPanel">

    <!-- ── Row 1: Problem Content / Emp. # / Date ── -->
    <div class="ac-row ac-row-header">

        <div class="ac-cell label-salmon">
            Problem Content :
        </div>
        <div class="ac-cell input-wide">
            <textarea id="tbProblemContent" class="ac-textarea upper"
                      placeholder="PROBLEM CONTENT" rows="2"></textarea>
        </div>

        <div class="ac-cell label-salmon label-sm">Emp. # :</div>
        <div class="ac-cell input-mid">
            <textarea id="tbInCharge" class="ac-textarea upper"
                      placeholder="EMPLOYEE NO." rows="2"></textarea>
        </div>

        <div class="ac-cell label-salmon label-sm">Date :</div>
        <div class="ac-cell input-sm">
            <input type="text" id="tbDate" class="ac-input" readonly />
        </div>
    </div>

    <!-- ── Row 2: Investigation Done / Action Taken ── -->
    <div class="ac-row">
        <div class="ac-cell label-salmon" style="width:156px;">Investigation Done :</div>
        <div class="ac-cell" style="flex:1">
            <textarea id="tbInvestigation" class="ac-textarea upper"
                      placeholder="INVESTIGATION DONE" rows="5"></textarea>
        </div>
        <div class="ac-cell label-salmon" style="width:120px;">Action Taken :</div>
        <div class="ac-cell" style="flex:1">
            <textarea id="tbAction" class="ac-textarea upper"
                      placeholder="ACTION TAKEN" rows="5"></textarea>
        </div>
    </div>

    <!-- ── MC Status dropdown ── -->
    <div class="ac-row">
        <div class="ac-cell label-salmon" style="width:156px;">MC Status :</div>
        <div class="ac-cell" style="flex:1">
            <select id="cbStatus" class="ac-select">
                @foreach (var opt in MachineKarte.Web.Models.McStatusOptions.All)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         DIVISION COMMENTS  ×3  (LimeGreen labels)
         Mirrors tbComment/tbdate_1/tbIncharge_1 etc.
         Date auto-sets on blur when comment is filled.
         ════════════════════════════════════════════ -->
    <div class="section-header limegreen-header">Division / Follow-up Comments</div>

    @for (int i = 1; i <= 3; i++)
    {
        <div class="ac-row comment-row">
            <div class="ac-cell label-limegreen" style="width:80px;">
                Comment @i :
            </div>
            <div class="ac-cell" style="flex:1">
                <textarea id="tbComment@(i == 1 ? "" : i.ToString())"
                      class="ac-textarea comment-ta"
                      data-comment-idx="@i"
                      onblur="onCommentBlur(this, @i)"
                      rows="3"
                      placeholder="COMMENT @i"></textarea>
            </div>
            <div class="ac-cell label-limegreen" style="width:52px;">Emp.</div>
            <div class="ac-cell" style="width:160px;">
                <input type="text" id="tbIncharge_@i" class="ac-input upper"
                       placeholder="EMP #" />
            </div>
            <div class="ac-cell label-limegreen" style="width:52px;">Date:</div>
            <div class="ac-cell" style="width:200px;">
                <input type="text" id="tbdate_@i" class="ac-input" readonly />
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════
         PM / TE REPLIES  ×3
         Label18/21/24 text changes to "TE Reply" when userType = TE.
         Date auto-sets on blur when reply is filled.
         ════════════════════════════════════════════ -->
    <div class="section-header limegreen-header">
        <span id="replyLabel">PM Reply</span>
    </div>

    @for (int i = 1; i <= 3; i++)
    {
        <div class="ac-row reply-row">
            <div class="ac-cell label-limegreen reply-label-cell"
                 id="replyLabelCell@i">
                PM Reply @i :
            </div>
            <div class="ac-cell" style="flex:1">
                <textarea id="tbReply@i"
                      class="ac-textarea reply-ta"
                      data-reply-idx="@i"
                      onblur="onReplyBlur(this, @i)"
                      rows="3"
                      placeholder="PM REPLY @i"></textarea>
            </div>
            <div class="ac-cell label-limegreen" style="width:52px;">Emp.</div>
            <div class="ac-cell" style="width:160px;">
                <input type="text" id="tbReplyEmp@i" class="ac-input upper"
                       placeholder="EMP #" />
            </div>
            <div class="ac-cell label-limegreen" style="width:52px;">Date:</div>
            <div class="ac-cell" style="width:200px;">
                <input type="text" id="tbReplyDate@i" class="ac-input" readonly />
            </div>
        </div>
    }

    <!-- ── Save button  (btnSave) ── -->
    <div class="ac-row ac-footer">
        <button id="btnSave" class="btn-save" onclick="saveCard()">SAVE</button>
        <span id="saveStatus" class="save-status"></span>
    </div>

</div><!-- /ac-panel -->
<!-- Hidden fields carrying load parameters -->
<input type="hidden" id="hfBmId" value="" />
<input type="hidden" id="hfMcNo" value="" />
<input type="hidden" id="hfUserType" value="PM" />
<input type="hidden" id="hfStatusId" value="New" />
<input type="hidden" id="hfColorName" value="" />

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/Assets/js/ActionCard.js"></script>
}