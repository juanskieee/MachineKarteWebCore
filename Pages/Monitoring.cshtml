@page
@model MachineKarte.Web.Pages.MonitoringModel
@{
    ViewData["Title"] = "E-Karte";
    Layout = "_Layout";
}
<div class="monitoring-screen">
    <header class="monitoring-deck">
        <section class="monitoring-overview" aria-label="Floor overview">
            <div id="floorSummaryPanel" class="floor-summary-panel">
                <table id="floorSummaryGrid" class="floor-summary-grid" aria-label="Action items by location">
                    <thead><tr><th scope="col">Action Item</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="monitoring-heading">
                <div class="ekarte-brand">
                    <img src="/favicon.ico"
                        alt="E-Karte System Logo"
                        class="ekarte-logo"
                        role="button"
                        tabindex="0"
                        aria-label="Show dancing cats"
                        data-cat-gifs="/Assets/images/dancing_cat.gif /Assets/images/dancing_cat_2.gif /Assets/images/dancing_cat_3.gif" />
                    <h1>E-Karte Web System</h1>
                </div>
                <div class="monitoring-status">
                    <details class="monitoring-legend">
                        <summary>Status &amp; action legend</summary>
                        <div class="legend-content">
                            <strong>Action badge: machine status</strong>
                            <dl class="legend-list">
                                <div><dt><span class="badge-action status-green">Action</span></dt><dd>Green: no re-occurrence after 7 days</dd></div>
                                <div><dt><span class="badge-action status-lightgreen">Action</span></dt><dd>Light green: running, lot evaluation</dd></div>
                                <div><dt><span class="badge-action status-red">Action</span></dt><dd>Red: stopped, ongoing investigation</dd></div>
                                <div><dt><span class="badge-action status-darkorange">Action</span></dt><dd>Orange: running, under 100% inspection</dd></div>
                                <div><dt><span class="badge-action status-darkgray">Action</span></dt><dd>Gray: running, investigation / monitoring</dd></div>
                                <div><dt><span class="badge-action status-violet">Action</span></dt><dd>Violet: waiting for inspection results</dd></div>
                                <div><dt><span class="badge-action status-aqua">Action</span></dt><dd>Aqua: waiting for QC instruction</dd></div>
                            </dl>
                            <strong>Action-card entries</strong>
                            <dl class="legend-list">
                                <div><dt><span class="bm-marker bm-marker-ac">AC</span></dt><dd>Action entered</dd></div>
                                <div><dt><span class="bm-marker bm-marker-sm">SM</span></dt><dd>Section Manager comment entered</dd></div>
                                <div><dt><span class="bm-marker bm-marker-dm">DM</span></dt><dd>Department Manager comment entered</dd></div>
                                <div><dt><span class="bm-marker bm-marker-dv">DV</span></dt><dd>Division Manager comment entered</dd></div>
                                <div><dt><span class="badge-mcd" role="img" aria-label="Three stars">&#9733;&#9733;&#9733;</span></dt><dd>Major Customer Device; blinking means no action card</dd></div>
                            </dl>
                        </div>
                    </details>
                    <div class="refresh-clock"><span>Refresh</span><span id="lblTimer" class="lbl-timer">600</span><span>s</span></div>
                </div>
            </div>
        </section>
        <form id="toolbar" class="monitoring-filters" onsubmit="event.preventDefault(); doSearch()">
            <div class="filter-user"><label for="cbUser">User</label><select id="cbUser" onchange="onUserChanged()">
                <option value="">-Select-</option>
                @foreach (var user in new[] { "PM", "CC", "EEE", "VIS", "TE" }) { <option value="@user">@user</option> }
            </select></div>
            <div><label for="cbProcess" id="lblProcessLabel">Process</label><select id="cbProcess" onchange="onProcessChanged()"><option value="-Select-">-Select-</option></select></div>
            <div><label for="cbFloor">Location</label><select id="cbFloor" onchange="onFloorChanged()"><option value="-Select-">-Select-</option></select></div>
            <div><label for="cbMachine" id="lblMachineLabel">Machine</label><select id="cbMachine"><option value="">-Select-</option></select></div>
            <div><label for="dt1">From</label><input type="date" id="dt1" value="@Model.DefaultDateFrom" data-time="@Model.DefaultTime" required /></div>
            <div><label for="dt2">To</label><input type="date" id="dt2" value="@Model.DefaultDateTo" data-time="@Model.DefaultTime" required /></div>
            <button id="btnSearch" class="btn-search" type="submit">Search</button>
            <button id="btnClearFilters" class="btn-clear-filters" type="button">Clear Filters</button>
            <div class="pagination-group" aria-label="Machine pages">
                <button id="btnPrev" type="button" class="btn-page" onclick="changePage(-1)" aria-label="Previous page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
                <span id="lblPageNumber" class="page-number" aria-label="Page 1 of 1" aria-live="polite">1/1</span>
                <button id="btnNext" type="button" class="btn-page" onclick="changePage(1)" aria-label="Next page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
            </div>
        </form>
    </header>
    <dialog id="machineListSidebar" class="machine-list-sidebar" aria-labelledby="sidebarTitle">
        <div class="summary-panel-header"><strong id="sidebarTitle">Machines</strong><button type="button" class="summary-panel-close" onclick="closeSidebar()" aria-label="Close machine list">&times;</button></div>
        <p class="summary-panel-hint">Select a machine to view its BM records.</p>
        <ul id="listboxMain" class="listbox-main summary-machine-list"></ul>
        <div class="summary-panel-footer"><button id="machineListGo" class="summary-panel-go" type="button" disabled>View selected machine</button></div>
    </dialog>
    <div id="cardContainer" class="card-container">
        <div id="loadingSpinner"
             class="loading-state is-hidden"
             role="status">
            <span class="spinner"></span>
            <div class="loading-content">
                <strong>Loading Machine Histories</strong>
                <span>Please wait while records are being retrieved...</span>
            </div>
        </div>

        <div id="monitoringWelcome"
             class="monitoring-state monitoring-state--welcome">
            <div class="monitoring-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M10.5 3a7.5 7.5 0 1 1 0 15a7.5 7.5 0 0 1 0-15zm0 2a5.5 5.5 0 1 0 0 11a5.5 5.5 0 0 0 0-11zm7.7 11.3L22 20.1L20.1 22l-3.8-3.8z" />
                </svg>
            </div>

            <h3>Machine Monitoring</h3>

            <p>
                Select a user, process, location, and machine,
                then click <strong>Search</strong> to view BM history.
            </p>
        </div>

        <div id="noResultMsg"
             class="monitoring-state monitoring-state--empty is-hidden">
            <div class="monitoring-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 5h16v10H4zm1.5 1.5v.2l6.5 4.9l6.5-4.9v-.2zm13 7V8.6L12 13.5L5.5 8.6v4.9zM4 17h16v2H4z" />
                </svg>
            </div>

            <h3>No Records Found</h3>

            <p>
                No machine histories matched the selected filters.
                Try another process, location, machine, or date range.
            </p>
        </div>

        <div id="machineBoard" class="machine-board is-hidden">
            <div id="cardScroller"
                 class="card-scroller machine-scroll-area"
                 tabindex="0"
                 role="region"
                 aria-label="Machine BM histories"></div>
            <div id="machineHeaderRow" class="machine-header-row"></div>
        </div>
    </div>
    <div id="toastMsg" class="toast-msg is-hidden" role="status" aria-live="polite"></div>
</div>
@await Html.PartialAsync("_WorkflowDialog")
@Html.AntiForgeryToken()
@section Styles {
    <link rel="stylesheet" href="@Url.VersionedAsset("Assets/css/Monitoring.css")" />
    <link rel="stylesheet" href="@Url.VersionedAsset("Assets/css/Workflows.css")" />
    <link rel="stylesheet" href="@Url.VersionedAsset("Assets/css/ActionCard.css")" />
    <link rel="stylesheet" href="@Url.VersionedAsset("Assets/css/RawData.css")" />
    <link rel="stylesheet" href="@Url.VersionedAsset("Assets/css/OcapViewer.css")" />
}
@section Scripts {
    <script src="@Url.VersionedAsset("Assets/js/shared/Common.js")"></script>
    <script src="@Url.VersionedAsset("Assets/js/monitoring/Monitoring.js")"></script>
    <script src="@Url.VersionedAsset("Assets/js/shared/Workflows.js")"></script>
    @foreach (var script in new[] {
        "summaries/AlertBoard", "summaries/MachineSummary", "summaries/McdMonitoring", "summaries/BmAnalytics",
        "records/ActionCard", "records/RawData", "records/OcapViewer",
        "reports/PmReport", "reports/BmReport", "reports/EvidenceMaking", "reports/TeEvidenceMaking"
    })
    {
        <script src="@Url.VersionedAsset($"Assets/js/{script}.js")"></script>
    }
}
