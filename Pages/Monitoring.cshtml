@page
@model MachineKarte.Web.Pages.MonitoringModel
@{
    ViewData["Title"] = "Machine Monitoring";
    ViewData["Page"] = "Monitoring";
    Layout = "_Layout";
}

<div id="toolbar" class="toolbar">

    <div class="toolbar-group">
        <label class="toolbar-label">User</label>
        <select id="cbUser" class="toolbar-select" onchange="onUserChanged()">
            <option value="">-Select-</option>
            <option value="PM">PM</option>
            <option value="CC">CC</option>
            <option value="EEE">EEE</option>
            <option value="VIS">VIS</option>
            <option value="TE">TE</option>
        </select>
    </div>

    <div class="toolbar-group">
        <label class="toolbar-label" id="lblProcessLabel">Machine</label>
        <select id="cbProcess" class="toolbar-select" onchange="onProcessChanged()">
            <option value="-Select-">-Select-</option>
        </select>
    </div>

    <div class="toolbar-group">
        <label class="toolbar-label">Floor</label>
        <select id="cbFloor" class="toolbar-select" onchange="onFloorChanged()">
            <option value="-Select-">-Select-</option>
        </select>
    </div>

    <div class="toolbar-group">
        <label class="toolbar-label">Machine</label>
        <select id="cbMachine" class="toolbar-select">
            <option value="">-Select-</option>
        </select>
    </div>

    <div class="toolbar-group">
        <label class="toolbar-label">From</label>
        <input type="date" id="dt1" class="toolbar-date" value="@Model.DefaultDateFrom" />
    </div>

    <div class="toolbar-group">
        <label class="toolbar-label">To</label>
        <input type="date" id="dt2" class="toolbar-date" value="@Model.DefaultDateTo" />
    </div>

    <button id="btnSearch" class="btn-search" onclick="doSearch()">Search</button>

    <div class="toolbar-group pagination-group">
        <button id="btnPrev" class="btn-page" onclick="changePage(-1)">◀</button>
        <span id="lblPageNumber" class="page-number">1</span>
        <button id="btnNext" class="btn-page" onclick="changePage(1)">▶</button>
    </div>

    <div class="toolbar-group">
        <span id="lblTimer" class="lbl-timer">600</span>
    </div>

    <div class="toolbar-group nav-buttons">
        <button id="btnRepeatBM" class="btn-nav btn-repeatbm"
                onclick="openSection('RepeatBM')">
            Repeat BM
        </button>

        <button id="btnMCD" class="btn-nav btn-mcd"
                onclick="openSection('MCD')">
            MCD
        </button>

        <button id="btnWithAction" class="btn-nav btn-action"
                onclick="openSection('WithAction')">
            With Action
        </button>
    </div>

</div>

<div id="floorSummaryPanel" class="floor-summary-panel" style="display:none;">
    <button id="btnCloseSummary" class="btn-close-summary" onclick="toggleSummary()">▲ Hide</button>

    <div id="floorSummaryGrid" class="floor-summary-grid">
    </div>
</div>

<div id="machineListSidebar" class="machine-list-sidebar" style="display:none;">
    <div class="sidebar-header">
        <span id="sidebarTitle">Machines</span>
        <button class="btn-close-sidebar" onclick="closeSidebar()">✕</button>
    </div>

    <ul id="listboxMain" class="listbox-main"></ul>
</div>

<div id="cardContainer" class="card-container">
    <div id="cardScroller" class="card-scroller">

        <div id="noResultMsg" class="no-result-msg" style="display:none;">
            No machines found for the selected filters.
        </div>

        <div id="loadingSpinner" class="loading-spinner" style="display:none;">
            <div class="spinner"></div>
            <span>Loading...</span>
        </div>

    </div>
</div>

<div id="toastMsg" class="toast-msg" style="display:none;"></div>

<div class="modal fade"
     id="reportModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="reportModalTitle"
                    class="modal-title">
                    Generate File
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="reportBmId" />

                <input type="hidden"
                       id="reportProcess" />

                <input type="hidden"
                       id="reportType" />

                <div class="mb-3">
                    <strong>BM ID:</strong>
                    <span id="reportBmIdLabel"></span>
                </div>

                <div id="reportStatus"
                     class="small text-muted">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnGenerateDownload">
                    Generate & Download
                </button>

            </div>

        </div>
    </div>

</div>

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/Monitoring.css" />
}

@section Scripts {
    <script src="~/Assets/js/Monitoring.js"></script>
}