@page
@model MachineKarte.Web.Pages.MonitoringModel
@{
    ViewData["Title"] = "Machine Monitoring";
    Layout = "_Layout";
}
<div class="monitoring-screen">
    <header class="monitoring-deck">
        <section class="monitoring-overview" aria-label="Floor overview">
            <div id="floorSummaryPanel" class="floor-summary-panel">
                <table id="floorSummaryGrid" class="floor-summary-grid" aria-label="Action items by location">
                    <thead><tr><th scope="col">Action Item</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="monitoring-heading">
                <h1>E-Karte System</h1>
                <details class="monitoring-legend">
                    <summary>Status &amp; action legend</summary>
                    <div class="legend-content">
                        <strong>Action badge: machine status</strong>
                        <span class="legend-green">Green: no re-occurrence after 7 days</span>
                        <span class="legend-lightgreen">Light green: running, lot evaluation</span>
                        <span class="legend-red">Red: stopped, ongoing investigation</span>
                        <span class="legend-orange">Orange: running, under 100% inspection</span>
                        <span class="legend-gray">Gray: running, investigation / monitoring</span>
                        <span class="legend-violet">Violet: waiting for inspection results</span>
                        <span class="legend-aqua">Aqua: waiting for QC instruction</span>
                        <p>Existing actions turn green when the legacy seven-day check marks a repeated case solved, measured against the machine's newest BM record.</p>
                        <strong>Action-card entries</strong>
                        <span class="legend-ac">AC: action entered</span>
                        <span class="legend-sky">SM: Section Manager comment entered</span>
                        <span class="legend-purple">DM: Department Manager comment entered</span>
                        <span class="legend-lime">DV: Division Manager comment entered</span>
                        <p>Need Action counts repeat BM groups within seven days that have no action card. A blinking red/white header and date identify a group needing action. Individual BM records are not counted separately.</p>
                        <p>Blinking blue/red case text follows the process-specific repeat category; TE requires QUALITY BM. Three stars mark a Major Customer Device (MCD); blinking stars identify a record without an action card, following the legacy group rules.</p>
                        <p>Salmon, blue, purple, and green card bands follow the machine's ActionLine thresholds. These bands are separate from the Action badge's machine status.</p>
                    </div>
                </details>
            </div>
        </section>
        <form id="toolbar" class="monitoring-filters" onsubmit="event.preventDefault(); doSearch()">
            <div class="filter-user"><label for="cbUser">User</label><select id="cbUser" onchange="onUserChanged()">
                <option value="">-Select-</option>
                @foreach (var user in new[] { "PM", "CC", "EEE", "VIS", "TE" }) { <option value="@user">@user</option> }
            </select></div>
            <div><label for="cbProcess" id="lblProcessLabel">Process</label><select id="cbProcess" onchange="onProcessChanged()"><option value="-Select-">-Select-</option></select></div>
            <div><label for="cbFloor">Location</label><select id="cbFloor" onchange="onFloorChanged()"><option value="-Select-">-Select-</option></select></div>
            <div><label for="cbMachine">Machine</label><select id="cbMachine"><option value="">-Select-</option></select></div>
            <div><label for="dt1">From</label><input type="date" id="dt1" value="@Model.DefaultDateFrom" required /></div>
            <div><label for="dt2">To</label><input type="date" id="dt2" value="@Model.DefaultDateTo" required /></div>
            <button id="btnSearch" class="btn-search" type="submit">Search</button>
            <div class="pagination-group" aria-label="Machine pages">
                <button id="btnPrev" type="button" class="btn-page" onclick="changePage(-1)" aria-label="Previous page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
                <span id="lblPageNumber" class="page-number" aria-label="Page 1 of 1" aria-live="polite">1/1</span>
                <button id="btnNext" type="button" class="btn-page" onclick="changePage(1)" aria-label="Next page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
            </div>
            <div class="refresh-clock"><span>Refresh</span><span id="lblTimer" class="lbl-timer">600</span><span>s</span></div>
        </form>
    </header>
    <dialog id="machineListSidebar" class="machine-list-sidebar" aria-labelledby="sidebarTitle">
        <div class="summary-panel-header"><strong id="sidebarTitle">Machines</strong><button type="button" class="summary-panel-close" onclick="closeSidebar()" aria-label="Close machine list">&times;</button></div>
        <p class="summary-panel-hint">Select a machine to view its BM records.</p>
        <ul id="listboxMain" class="listbox-main summary-machine-list"></ul>
        <div class="summary-panel-footer"><button id="machineListGo" class="summary-panel-go" type="button" disabled>View selected machine</button></div>
    </dialog>
    <div id="cardContainer" class="card-container">
        <div id="cardScroller" class="card-scroller">
            <div id="noResultMsg" class="no-result-msg is-hidden">No machines found for the selected filters.</div>
            <div id="loadingSpinner" class="loading-spinner is-hidden" role="status"><span class="spinner"></span>Loading machines…</div>
            <p id="monitoringWelcome" class="monitoring-welcome">Select a user, process, location, and machine, then Search.</p>
        </div>
    </div>
    <div id="toastMsg" class="toast-msg is-hidden" role="status" aria-live="polite"></div>
</div>
@await Html.PartialAsync("_WorkflowDialog")
@Html.AntiForgeryToken()
@section Styles {
    <link rel="stylesheet" href="~/Assets/css/Monitoring.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/Workflows.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/ActionCard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/RawData.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/OcapViewer.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/Assets/js/Monitoring.js" asp-append-version="true"></script>
    <script src="~/Assets/js/Workflows.js" asp-append-version="true"></script>
    @foreach (var script in new[] { "AlertBoard", "MachineSummary", "McdMonitoring", "BmAnalytics", "ActionCard", "RawData", "OcapViewer", "PmReport", "BmReport", "EvidenceMaking", "TeEvidenceMaking" })
    {
        <script src="~/Assets/js/@(script).js" asp-append-version="true"></script>
    }
}
