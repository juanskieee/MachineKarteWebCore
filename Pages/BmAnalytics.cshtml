@page
@model MachineKarte.Web.Pages.BmAnalyticsModel
@{
    ViewData["Title"] = "BM Analytics";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/BmAnalytics.css" asp-append-version="true" />
}

<!-- ======================================================================
     BM Analytics — process × location grid of MCD machines WITH action cards
     Mirrors Form12.vb  (NewLoadColor path only)
     ====================================================================== -->

<div class="bma-page">

    <!-- ── Top toolbar ─────────────────────────────────────────────────── -->
    <div class="bma-toolbar card shadow-sm">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1 small fw-semibold">Date From</label>
                <input type="datetime-local" id="dtFrom" class="form-control form-control-sm"
                       value="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1 small fw-semibold">Date To</label>
                <input type="datetime-local" id="dtTo" class="form-control form-control-sm"
                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1 small fw-semibold">Mode</label>
                <select id="selMode" class="form-select form-select-sm">
                    <option value="EEE">EEE</option>
                    <option value="TE">TE</option>
                </select>
            </div>
            <div class="col-auto">
                <button id="btnSearch" class="btn btn-primary btn-sm px-4">
                    <span id="searchSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    Search
                </button>
            </div>
            <div class="col-auto ms-auto text-muted small" id="lblStatus"></div>
        </div>
    </div>

    <!-- ── Grid container ──────────────────────────────────────────────── -->
    <div class="bma-grid-wrapper mt-3" id="gridWrapper">
        <div class="text-center text-muted py-5" id="noData">
            Select a date range and click <strong>Search</strong>.
        </div>
    </div>

    <!-- ── Machine flyout panel ─────────────────────────────────────────  -->
    <div class="bma-flyout card shadow" id="flyoutPanel" style="display:none;">
        <div class="card-header d-flex align-items-center justify-content-between py-2">
            <span class="fw-bold" id="flyoutTitle"></span>
            <button class="btn btn-sm btn-outline-secondary" id="btnCloseFlyout">✕</button>
        </div>
        <div class="card-body p-2">
            <ul class="list-group list-group-flush" id="flyoutList" style="max-height:300px;overflow-y:auto;"></ul>
        </div>
        <div class="card-footer py-2 d-flex gap-2">
            <button class="btn btn-sm btn-success" id="btnViewMonitoring">View in Monitoring</button>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/BmAnalytics.js" asp-append-version="true"></script>
}