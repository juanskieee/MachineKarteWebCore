@model MachineKarte.Web.Pages.EvidenceMakingModel
@{ Layout = null; }
<div class="workflow workflow--EvidenceMaking" data-workflow="EvidenceMaking">
    <div class="document-toolbar">
        <p>Process: <strong data-id="recordProcess"></strong> | BM ID: <strong data-id="recordBmId"></strong></p>
        <button type="button" id="EvidenceMaking-btnGenerate" data-id="btnGenerate" class="btn-generate" data-action="generate">Generate evidence</button>
    </div>
    <p class="document-note">Generate the evidence workbook, then choose Download to save it.</p>
    <div id="EvidenceMaking-statusArea" data-id="statusArea" class="status-area is-hidden">
        <div id="EvidenceMaking-statusSpinner" data-id="statusSpinner" class="status-spinner is-hidden">
            <span class="spinner"></span><span>Generating evidence…</span>
        </div>
        <p id="EvidenceMaking-statusMsg" data-id="statusMsg" class="status-msg" role="status" aria-live="polite"></p>
    </div>
    <div id="EvidenceMaking-previewPanel" data-id="previewPanel" class="preview-panel is-hidden">
        <div class="preview-toolbar">
            <span id="EvidenceMaking-previewFileName" data-id="previewFileName" class="preview-filename"></span>
            <a id="EvidenceMaking-downloadLink" data-id="downloadLink" class="btn-download" href="#" download>Download</a>
            <button type="button" data-action="close-preview">Close result</button>
        </div>
        <iframe title="Evidence preview" id="EvidenceMaking-previewFrame" data-id="previewFrame" class="preview-frame" src=""></iframe>
    </div>
    @Html.AntiForgeryToken()
</div>
