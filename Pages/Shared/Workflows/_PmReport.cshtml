@model MachineKarte.Web.Models.ReportWorkflowViewModel
@{ Layout = null; }
<div class="workflow workflow--PmReport" data-workflow="PmReport">
    <div class="document-toolbar">
        <p>Process: <strong id="PmReport-pmProcess" data-id="pmProcess">@Model.Process</strong> | BM ID: <strong id="PmReport-pmBmId" data-id="pmBmId">@Model.BmId</strong></p>
        <div class="document-actions">
            <label>Format <select data-id="outputFormat"><option value="xlsx">Excel (.xlsx)</option><option value="pdf">PDF</option></select></label>
            <button id="PmReport-pmGenerate" data-id="pmGenerate" class="btn-generate" type="button">Generate report</button>
        </div>
    </div>
    <p class="document-note">Generate the report in Excel or PDF, then choose Download to save it.</p>
    <div data-id="statusArea" class="status-area is-hidden">
        <div data-id="statusSpinner" class="status-spinner is-hidden">
            <span class="spinner"></span><span>Generating report…</span>
        </div>
        <p id="PmReport-pmStatus" data-id="pmStatus" class="status-msg" role="status" aria-live="polite"></p>
    </div>
    @await Html.PartialAsync("/Pages/Shared/Workflows/_ReportHistory.cshtml")
    <div data-id="previewPanel" class="preview-panel is-hidden">
        <div class="preview-toolbar">
            <span data-id="previewFileName" class="preview-filename"></span>
            <a id="PmReport-pmDownload" data-id="pmDownload" class="btn-download" href="#" download>Download</a>
        </div>
        <iframe data-id="previewFrame" class="preview-frame is-hidden" title="PM maintenance report PDF preview" loading="lazy"></iframe>
    </div>
</div>
