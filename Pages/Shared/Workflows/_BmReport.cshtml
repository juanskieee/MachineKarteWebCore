@model MachineKarte.Web.Models.ReportWorkflowViewModel
@{ Layout = null; }
<div class="workflow workflow--BmReport" data-workflow="BmReport">
    <div class="document-toolbar">
        <p>Process: <strong>@Model.Process</strong> | BM ID: <strong>@Model.BmId</strong></p>
        <form id="BmReport-frmDownload" data-id="frmDownload" method="post" action="/BmReport?handler=DownloadReport&amp;metadata=true">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bmId" value="@Model.BmId" />
            <input type="hidden" name="process" value="@(string.IsNullOrEmpty(Model.Process) ? "TE" : Model.Process)" />
            <label>Format <select name="format" data-id="outputFormat"><option value="xlsx">Excel (.xlsx)</option><option value="pdf">PDF</option></select></label>
            <button type="submit" id="BmReport-btnDownload" data-id="btnDownload" class="btn-generate">Generate report</button>
        </form>
    </div>
    <p class="document-note">Generate the report in Excel or PDF, then choose Download to save it.</p>
    <div data-id="statusArea" class="status-area is-hidden">
        <div data-id="statusSpinner" class="status-spinner is-hidden">
            <span class="spinner"></span><span>Generating report…</span>
        </div>
        <p id="BmReport-reportStatus" data-id="reportStatus" class="status-msg" role="status" aria-live="polite"></p>
    </div>
    @await Html.PartialAsync("/Pages/Shared/Workflows/_ReportHistory.cshtml")
    <div data-id="previewPanel" class="preview-panel is-hidden">
        <div class="preview-toolbar">
            <span data-id="previewFileName" class="preview-filename"></span>
            <a data-id="reportDownload" class="btn-download" href="#" download>Download</a>
        </div>
        <iframe data-id="previewFrame" class="preview-frame is-hidden" title="TE maintenance report PDF preview" loading="lazy"></iframe>
    </div>
</div>
