@model MachineKarte.Web.Pages.BmReportModel
@{ Layout = null; }
<div class="workflow workflow--BmReport" data-workflow="BmReport">
    <div class="document-toolbar">
        <p>Process: <strong>@Model.Process</strong> | BM ID: <strong>@Model.BmId</strong></p>
        <form id="BmReport-frmDownload" data-id="frmDownload" method="post" action="/BmReport?handler=DownloadReport">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bmId" value="@Model.BmId" />
            <input type="hidden" name="process" value="@(string.IsNullOrEmpty(Model.Process) ? "TE" : Model.Process)" />
            <button type="submit" id="BmReport-btnDownload" data-id="btnDownload" class="btn-download">Generate report</button>
        </form>
    </div>
    <p class="document-note">Generate the maintenance workbook, then choose Download to save it.</p>
    <p id="BmReport-reportStatus" data-id="reportStatus" class="report-status" role="status" aria-live="polite" hidden></p>
    <a data-id="reportDownload" class="btn-download" hidden download>Download report (.xlsx)</a>
</div>
