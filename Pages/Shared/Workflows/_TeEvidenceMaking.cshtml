@model MachineKarte.Web.Pages.TeEvidenceMakingModel
@{ Layout = null; }
<div class="workflow workflow--TeEvidenceMaking legacy-document" data-workflow="TeEvidenceMaking">
    <div class="document-toolbar">
        <p>Process: <strong data-id="recordProcess"></strong> | BM ID: <strong data-id="recordBmId"></strong></p>
        <button type="button" data-id="btnGenerate">Generate evidence</button>
    </div>
    <p class="document-note">Generate the evidence workbook, then choose Download to save it.</p>
    <p data-id="status" class="report-status" role="status" aria-live="polite" hidden></p>
    <a data-id="download" class="btn-download" hidden download>Download evidence workbook</a>
</div>
