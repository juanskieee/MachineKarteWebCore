@model MachineKarte.Web.Pages.TeEvidenceMakingModel
@{ Layout = null; }
<div class="workflow workflow--TeEvidenceMaking legacy-document" data-workflow="TeEvidenceMaking">
    <div class="document-toolbar">
        <p data-id="bmLabel">BM Maintenance Evidence</p>
        <button type="button" data-id="btnGenerate">Generate &amp; Download</button>
    </div>
    <div class="document-workspace">
        <p data-id="status" role="status" aria-live="polite">Generate the evidence workbook to view the maintenance evidence.</p>
        <a data-id="download" hidden download>Download evidence workbook</a>
    </div>
</div>
