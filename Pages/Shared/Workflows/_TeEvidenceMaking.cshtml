@{ Layout = null; }
<div class="workflow workflow--TeEvidenceMaking legacy-document" data-workflow="TeEvidenceMaking">
    <div class="document-toolbar">
        <p>Process: <strong data-id="recordProcess"></strong> | BM ID: <strong data-id="recordBmId"></strong></p>
        <div class="document-actions">
            <label>Format <select data-id="outputFormat"><option value="xlsx">Excel (.xlsx)</option><option value="pdf">PDF</option></select></label>
            <button type="button" data-id="btnGenerate" class="btn-generate">Generate evidence</button>
        </div>
    </div>
    <p class="document-note">Generate the evidence in Excel or PDF, then choose Download to save it.</p>
    <div data-id="statusArea" class="status-area is-hidden">
        <div data-id="statusSpinner" class="status-spinner is-hidden">
            <span class="spinner"></span><span>Generating evidence…</span>
        </div>
        <p data-id="status" class="status-msg" role="status" aria-live="polite"></p>
    </div>
    @await Html.PartialAsync("/Pages/Shared/Workflows/_ReportHistory.cshtml")
    <div data-id="previewPanel" class="preview-panel is-hidden">
        <div class="preview-toolbar">
            <span data-id="previewFileName" class="preview-filename"></span>
            <a data-id="download" class="btn-download" href="#" download>Download</a>
        </div>
        <iframe data-id="previewFrame" class="preview-frame is-hidden" title="TE maintenance evidence PDF preview" loading="lazy"></iframe>
    </div>
</div>
