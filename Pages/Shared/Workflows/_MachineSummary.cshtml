@model MachineKarte.Web.Pages.MachineSummaryModel
<div class="workflow workflow--MachineSummary" data-workflow="MachineSummary">
@{
    ViewData["Title"] = "Machine Summary — Need Action with MCD";
    Layout = null;
    var layout = new {
        columns = MachineSummaryConfig.DisplayColumns,
        modes = new[] { "EEE", "TE" }.ToDictionary(mode => mode, mode =>
            MachineSummaryConfig.EeeProcessOrder.Select(process => new {
                process, locations = MachineSummaryConfig.GetLocations(process, mode == "TE")
            }))
    };
}
<div class="ms-wrapper monitoring-family-page">
    <div class="ms-toolbar monitoring-family-toolbar summary-toolbar">
        <p class="summary-context" data-id="summaryContext"></p>
        <div class="summary-search">
            <span data-id="summaryLoading" class="summary-loading" role="status" hidden><span class="spinner" aria-hidden="true"></span>Loading…</span>
            <button id="MachineSummary-msSearch" data-id="msSearch" class="ms-btn-search" type="button">Search</button>
        </div>
        <span id="MachineSummary-msStatus" data-id="msStatus" class="ms-status summary-status" role="status" aria-live="polite"></span>
    </div>
    <div class="ms-grid-scroll monitoring-family-content summary-grid">
        <table id="MachineSummary-msGrid" data-id="msGrid" class="ms-grid" aria-label="Machine Summary Grid"
               data-layout="@System.Text.Json.JsonSerializer.Serialize(layout)">
            <thead id="MachineSummary-msGridHead" data-id="msGridHead"></thead>
            <tbody id="MachineSummary-msGridBody" data-id="msGridBody"></tbody>
            <tfoot id="MachineSummary-msGridFoot" data-id="msGridFoot"></tfoot>
        </table>
    </div>
    <div id="MachineSummary-msPanel" data-id="msPanel" class="ms-panel summary-machine-panel" aria-hidden="true">
        <div class="summary-panel-header">
            <span id="MachineSummary-msPanelTitle" data-id="msPanelTitle">Machines</span>
            <button id="MachineSummary-msPanelClose" data-id="msPanelClose" class="summary-panel-close" type="button" aria-label="Close machine list">&times;</button>
        </div>
        <p class="summary-panel-hint">Select a machine below:</p>
        <ul id="MachineSummary-msPanelList" data-id="msPanelList" class="ms-panel-list summary-machine-list"></ul>
        <div class="summary-panel-footer">
            <button id="MachineSummary-msPanelGo" data-id="msPanelGo" class="summary-panel-go" type="button" disabled>View in Monitoring</button>
        </div>
    </div>
    <div id="MachineSummary-msOverlay" data-id="msOverlay" class="ms-overlay" aria-hidden="true"></div>
</div>
@Html.AntiForgeryToken()
</div>
