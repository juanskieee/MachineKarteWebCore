<section class="report-history" aria-label="Saved files for this BM card">
    <div class="report-history-heading">
        <h3>Generated files</h3>
        <button type="button" data-id="historyRefresh">Refresh</button>
    </div>
    <p class="document-note">Saved for this BM card. Previous versions remain available after you close this window.</p>
    <p data-id="historyStatus" class="status-msg" role="status" aria-live="polite">Loading saved files…</p>
    <div data-id="historyTable" class="report-history-scroll is-hidden">
        <table class="report-history-table" aria-label="Generated Excel and PDF files, newest first">
            <thead><tr><th scope="col">File</th><th scope="col">Generated (local time)</th><th scope="col">Actions</th></tr></thead>
            <tbody data-id="historyFiles"></tbody>
        </table>
    </div>
</section>
