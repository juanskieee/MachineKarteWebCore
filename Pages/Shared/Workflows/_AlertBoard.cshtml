@model MachineKarte.Web.Pages.AlertBoardModel
<div class="workflow workflow--AlertBoard" data-workflow="AlertBoard">
@{
    ViewData["Title"] = "Repeat BM Alert Board";
    Layout = null;
    var processes = new[] { "DC", "DB", "WB", "MP", "PL", "ATC", "SING", "FL", "FT", "TP", "EDS", "MEMS" };
    var locations = new[] { "LSI1-1F", "LSI1-2F", "LSI2-1F", "LSI2-2F", "LSI2-3F", "LSI3-1F", "LSI3-2F", "LSI3-3F", "LSI3-4F" };
}
<div class="ab-container monitoring-family-page">
    <div class="ab-toolbar monitoring-family-toolbar summary-toolbar">
        <p class="summary-context" data-id="summaryContext"></p>
        <div class="summary-search">
            <span data-id="summaryLoading" class="summary-loading" role="status" hidden><span class="spinner" aria-hidden="true"></span>Loading…</span>
            <button id="AlertBoard-btnSearch" data-id="btnSearch" class="ab-btn-search" type="button">Search</button>
        </div>
        <p data-id="boardStatus" class="summary-status" role="status" aria-live="polite"></p>
    </div>
    <div class="ab-panel monitoring-family-content summary-grid">
        <div class="ab-header-row">
            <div class="ab-hdr-process">Process</div>
            @foreach (var location in locations) { <div class="ab-hdr-loc">@location</div> }
            <div class="ab-hdr-total">Total</div>
        </div>
        @foreach (var process in processes)
        {
            <div class="ab-proc-row">
                <div class="ab-cell-label">@process</div>
                @for (var index = 0; index < locations.Length; index++)
                {
                    <div id="AlertBoard-cell_@(process)_@index" data-id="cell_@(process)_@index" data-cell="@(process)_@index" class="ab-cell ab-cell-active">0</div>
                }
                <div id="AlertBoard-ptotal_@process" data-id="ptotal_@process" class="ab-cell ab-cell-total">0</div>
            </div>
        }
        <div class="ab-proc-row ab-totals-row">
            <div class="ab-cell-label">Total</div>
            @foreach (var location in locations) { <div id="AlertBoard-ltotal_@location" data-id="ltotal_@location" class="ab-cell ab-cell-total">0</div> }
            <div id="AlertBoard-grandTotal" data-id="grandTotal" class="ab-cell ab-cell-grand">0</div>
        </div>
    </div>
    <div id="AlertBoard-panelDrilldown" data-id="panelDrilldown" class="ab-drilldown summary-machine-panel is-hidden">
        <div class="summary-panel-header">
            <span id="AlertBoard-drilldownTitle" data-id="drilldownTitle"></span>
            <button id="AlertBoard-btnDrillClose" data-id="btnDrillClose" class="summary-panel-close" type="button" aria-label="Close machine list">&times;</button>
        </div>
        <p class="summary-panel-hint">Select a machine below:</p>
        <ul id="AlertBoard-drilldownList" data-id="drilldownList" class="ab-machine-list summary-machine-list"></ul>
        <div class="summary-panel-footer">
            <button id="AlertBoard-btnDrillGo" data-id="btnDrillGo" class="summary-panel-go" type="button" disabled>View in Monitoring</button>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()
</div>
